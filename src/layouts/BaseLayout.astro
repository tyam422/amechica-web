---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { BLOG_RSS_PATH, BLOG_TITLE } from "../lib/blog";

interface Props {
  title: string;
  description: string;
  current?: "home" | "guide" | "places" | "blog" | "about" | "other";
  ogType?: "website" | "article";
  ogImage?: string;
}

const { title, description, current = "other", ogType = "website", ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = new URL("/", Astro.site).href;
const logoUrl = new URL("/icon-512.png", Astro.site).href;
// Default share image is the amechica logo unless a page passes its own.
const ogImageUrl = new URL(ogImage ?? "/og-default.jpg", Astro.site).href;
const isDefaultOgImage = !ogImage;
const siteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "amechica",
      url: siteUrl,
      logo: logoUrl,
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: "amechica",
      url: siteUrl,
      inLanguage: "ja",
      publisher: { "@id": `${siteUrl}#organization` },
    },
  ],
});
const rawGaId = import.meta.env.PUBLIC_GA_ID;
const gaId =
  typeof rawGaId === "string" && /^G-[A-Z0-9]+$/i.test(rawGaId.trim())
    ? rawGaId.trim()
    : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={BLOG_TITLE} href={new URL(BLOG_RSS_PATH, Astro.site).href} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="amechica" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {isDefaultOgImage && <meta property="og:image:width" content="960" />}
    {isDefaultOgImage && <meta property="og:image:height" content="960" />}
    <meta property="og:image:alt" content={isDefaultOgImage ? "amechica" : title} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {current === "home" && <script type="application/ld+json" set:html={siteJsonLd} />}
    <slot name="head" />
    {
      gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
          <script define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#content">本文へスキップ</a>
    <Header current={current} />
    <main id="content">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
