---
interface Props {
  youtubeId?: string;
  title: string;
}

const { youtubeId, title } = Astro.props;
const id = youtubeId && /^[\w-]{11}$/.test(youtubeId) ? youtubeId : undefined;
const watchUrl = id ? `https://www.youtube.com/watch?v=${id}` : undefined;
const embedUrl = id ? `https://www.youtube-nocookie.com/embed/${id}` : undefined;
const jsonLd = id
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoObject",
      name: title,
      embedUrl,
      contentUrl: watchUrl,
      thumbnailUrl: `https://i.ytimg.com/vi/${id}/hqdefault.jpg`,
    })
  : undefined;
---

{
  id ? (
    <figure class="yt-embed">
      <p class="yt-embed__caption">この記事の動画版（YouTube）</p>
      <div class="yt-embed__frame">
        <iframe
          src={embedUrl}
          title="この記事の動画"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
      </div>
      <p class="yt-embed__link">
        <a href={watchUrl} target="_blank" rel="noopener">{watchUrl}</a>
      </p>
      <script type="application/ld+json" set:html={jsonLd} />
    </figure>
  ) : (
    <div class="yt-placeholder">
      <p>このトピックの動画は準備中です。</p>
    </div>
  )
}
