---
// ブログランキングのバナー（にほんブログ村 ＋ 人気ブログランキング）とブログ村のブログパーツ。
// 設定は src/lib/blogmura.ts と src/lib/with2.ts。どちらも未設定なら何も出力しない。
import { BLOGMURA_BANNER_HTML, BLOGMURA_PARTS_HTML } from "../lib/blogmura";
import { WITH2_BANNER_HTML } from "../lib/with2";

const banners = [BLOGMURA_BANNER_HTML.trim(), WITH2_BANNER_HTML.trim()].filter(Boolean);
const parts = BLOGMURA_PARTS_HTML.trim();
---

{
  (banners.length > 0 || parts) && (
    <aside class="blogmura-banner" aria-label="ブログランキング">
      {banners.length > 0 && (
        <div class="ranking-banners">
          {banners.map((html) => <div class="ranking-banners__item" set:html={html} />)}
        </div>
      )}
      {parts && <Fragment set:html={parts} />}
    </aside>
  )
}
