---
import { PLACES_ENABLED } from "../lib/places";

interface Props {
  current?: "home" | "guide" | "places" | "about" | "other";
}

const { current = "other" } = Astro.props;
// お店・スポット section: public.
const placesEnabled = PLACES_ENABLED;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label="amechica ホーム">
      <picture>
        <source srcset="/logo-amechica.webp" type="image/webp" />
        <img class="wordmark__logo" src="/logo-amechica.png" alt="amechica" width="171" height="128" decoding="async" />
      </picture>
      <span class="wordmark__tag">アメリカ生活シカゴ郊外</span>
    </a>
    <nav class="nav" aria-label="主な案内">
      <a href="/guide/" aria-current={current === "guide" ? "page" : undefined}>渡米ガイド</a>
      {placesEnabled && (
        <a href="/places/" aria-current={current === "places" ? "page" : undefined}>お店・スポット</a>
      )}
    </nav>
  </div>
</header>
