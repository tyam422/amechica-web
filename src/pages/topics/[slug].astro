---
import { getCollection, render } from "astro:content";
import TopicLayout from "../../layouts/TopicLayout.astro";
import { isPublished } from "../../lib/groups";

export async function getStaticPaths() {
  const topics = (await getCollection("topics")).filter((topic) => isPublished(topic));
  return topics.map((topic) => ({
    params: { slug: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);
---

<TopicLayout topic={topic}>
  <Content />
</TopicLayout>
