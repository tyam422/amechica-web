---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, getGroupByName, isPublished, topicPath } from "../lib/groups";
import { PLACES_ENABLED, isPlacePublished, placePath } from "../lib/places";
import { blogPath, isBlogPublished, lastModified, sortBlogPosts } from "../lib/blog";

// Latest topics: newest `updated` first; ties broken by the newest video.
const topics = (await getCollection("topics"))
  .filter((topic) => isPublished(topic))
  .sort(
    (a, b) =>
      b.data.updated.getTime() - a.data.updated.getTime() ||
      (b.data.youtubeUploadDate ?? "").localeCompare(a.data.youtubeUploadDate ?? ""),
  )
  .slice(0, 6);

// お店・スポット: published places with a website filled in.
const places = PLACES_ENABLED
  ? (await getCollection("places"))
      // Skip still-empty templates (no website filled in yet).
      .filter((place) => isPlacePublished(place) && place.data.website !== "")
      .sort(
        (a, b) => b.data.updated.getTime() - a.data.updated.getTime() || a.data.order - b.data.order,
      )
      .slice(0, 6)
  : [];

// ブログ: newest posts (by last change: updated, else publish date).
const posts = sortBlogPosts((await getCollection("blog")).filter((post) => isBlogPublished(post))).slice(0, 6);

// 最近の更新: topics, places and blog posts merged, newest date first.
const updates = [
  ...topics.map((topic) => ({ kind: "topic" as const, topic, date: topic.data.updated })),
  ...places.map((place) => ({ kind: "place" as const, place, date: place.data.updated })),
  ...posts.map((post) => ({ kind: "blog" as const, post, date: lastModified(post) })),
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<BaseLayout
  title="amechica — アメリカ生活シカゴ郊外"
  description="amechica（アメリカ生活シカゴ郊外）は、シカゴ郊外への引っ越しと、そこでの生活についての日本語の案内サイトです。"
  current="home"
>
  <section class="hero">
    <p class="hero__kicker">アメリカ生活シカゴ郊外</p>
    <h1>シカゴ郊外の暮らしを、日本語で。</h1>
    <p class="lead">
      amechica（アメリカ生活シカゴ郊外）は、シカゴ郊外へ引っ越す人と、そこで暮らす人のための日本語の案内サイトです。
    </p>
    <p>
      引っ越し前後の手続きや生活の仕組みを、シカゴ郊外（イリノイ州）を例にまとめています。仕組みの多くは米国全般に通じます。
    </p>
  </section>

  <div class="home-cards">
    <a class="home-card" href="/guide/">
      <span class="home-card__title">渡米ガイド</span>
      <span class="home-card__desc">引っ越し前後の手続き・生活情報</span>
      <span class="home-card__more" aria-hidden="true">見る →</span>
    </a>
    {
      PLACES_ENABLED && (
        <a class="home-card" href="/places/">
          <span class="home-card__title">お店・スポット</span>
          <span class="home-card__desc">シカゴ郊外のお店・スポット情報</span>
          <span class="home-card__more" aria-hidden="true">見る →</span>
        </a>
      )
    }
    <a class="home-card" href="/blog/">
      <span class="home-card__title">ブログ</span>
      <span class="home-card__desc">シカゴ郊外での暮らしの体験談</span>
      <span class="home-card__more" aria-hidden="true">見る →</span>
    </a>
  </div>

  <section class="group-block" aria-labelledby="recent-updates">
    <div class="group-block__head">
      <h2 id="recent-updates">最近の更新</h2>
    </div>
    <ul class="topic-list">
      {updates.map((u) =>
        u.kind === "blog" ? (
          (() => { const post = u.post; return (
        <li>
          <a href={blogPath(post.id)}>
            <span class="topic-list__title">{post.data.title}</span>
            <span class="topic-list__desc">
              ブログ　{post.data.updated ? "更新日" : "公開日"}：{formatDate(lastModified(post))}
            </span>
          </a>
        </li>
          ); })()
        ) : u.kind === "topic" ? (
          (() => { const topic = u.topic; return (
        <li>
          <a href={topicPath(topic.id)}>
            <span class="topic-list__title">{topic.data.title}</span>
            <span class="topic-list__desc">
              渡米ガイド・{getGroupByName(topic.data.group)?.name}　更新日：{formatDate(topic.data.updated)}
            </span>
          </a>
        </li>
          ); })()
        ) : (
          (() => { const place = u.place; return (
        <li>
          <a href={placePath(place.id)}>
            <span class="topic-list__title">
              {place.data.nameJa ? `${place.data.nameJa}（${place.data.name}）` : place.data.name}
            </span>
            <span class="topic-list__desc">
              お店・スポット{place.data.category ? `・${place.data.category}` : ""}　更新日：{formatDate(place.data.updated)}
            </span>
          </a>
        </li>
          ); })()
        ),
      )}
    </ul>
  </section>
</BaseLayout>
